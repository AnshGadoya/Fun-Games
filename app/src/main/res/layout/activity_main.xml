<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/main_background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/appBar_background"
        android:elevation="4dp">

        <androidx.appcompat.widget.Toolbar
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

            <ImageView
                android:id="@+id/menu_icon"
                android:layout_width="80dp"
                android:layout_height="30dp"
                android:contentDescription="Menu"
                android:src="@drawable/menu1" />



            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_weight="1"
                android:paddingEnd="28dp"
                android:text="Fun Games"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:background="@color/divider"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="3"
        android:layout_margin="16dp"
        android:paddingBottom="12dp"
        android:columnOrderPreserved="false">

        <!-- Block Fill -->
        <androidx.cardview.widget.CardView
            android:id="@+id/word_search"
            android:layout_width="0dp"
            android:layout_height="220dp"
            android:layout_margin="12dp"
            android:layout_columnWeight="1"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@color/card_background"
            app:cardElevation="4dp">



                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/word_search"
                    android:contentDescription="word_search"
                    android:scaleType="fitXY"/>

        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:id="@+id/flappy_bird"
            android:layout_width="0dp"
            android:layout_height="220dp"
            android:layout_margin="12dp"
            android:layout_columnWeight="1"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@color/card_background"
            app:cardElevation="4dp">



            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/flappybird_logo"
                android:contentDescription="ludo"
                android:scaleType="fitXY"/>

        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:id="@+id/memory_game"
            android:layout_width="0dp"
            android:layout_height="220dp"
            android:layout_margin="12dp"
            android:layout_columnWeight="1"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@color/card_background"
            app:cardElevation="4dp">



            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/memory"
                android:contentDescription="memory"
                android:scaleType="fitXY"/>

        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:id="@+id/sound_memory"
            android:layout_width="0dp"
            android:layout_height="220dp"
            android:layout_margin="12dp"
            android:layout_columnWeight="1"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@color/card_background"
            app:cardElevation="4dp">



            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/sound_memory"
                android:contentDescription="sound_memory"
                android:scaleType="fitXY"/>

        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView

            android:id="@+id/tic_tac_toe"
            android:layout_width="0dp"
            android:layout_height="220dp"
            android:layout_margin="12dp"
            android:layout_columnWeight="1"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@color/card_background"
            app:cardElevation="4dp">



            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/tic_tac_toe"
                android:contentDescription="tic_tac_toe"
                android:scaleType="fitXY"/>

        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:id="@+id/color_hunt"
            android:layout_width="0dp"
            android:layout_height="220dp"
            android:layout_margin="12dp"
            android:layout_columnWeight="1"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@color/card_background"
            app:cardElevation="4dp">



            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/color_hunt"
                android:contentDescription="color_hunt"
                android:scaleType="fitXY"/>

        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="220dp"
            android:layout_margin="12dp"
            android:layout_columnWeight="1"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@color/card_transparent"
            app:cardElevation="4dp">



            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@drawable/comming_soon"
                android:contentDescription="color_hunt"
                android:scaleType="fitXY"/>

        </androidx.cardview.widget.CardView>






    </GridLayout>
</ScrollView>

</LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/white" />
</androidx.drawerlayout.widget.DrawerLayout>