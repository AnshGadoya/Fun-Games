<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".soundMemory.smg_gameScreen"
    android:background="@color/color_dark">

        <!-- Top Score Cards -->
        <LinearLayout
            android:id="@+id/score_cards"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:layout_centerHorizontal="true">

                <!-- HARD MODE Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="100dp"
                    android:layout_height="70dp"
                    android:layout_margin="4dp"
                    app:cardCornerRadius="8dp"
                    app:cardBackgroundColor="#333333">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Player Turn : "
                                    android:textColor="#FFFFFF"
                                    android:textStyle="bold"
                                    android:textSize="15sp" />

                                <TextView
                                    android:id="@+id/tv_who_is_playing"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text=" "
                                    android:textColor="@color/color_white"
                                    android:textAlignment="center" />
                        </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- ALL TIME Card with Crown -->
                <FrameLayout
                    android:layout_width="100dp"
                    android:layout_height="70dp"
                    android:layout_margin="4dp">

                        <!-- Card -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:cardCornerRadius="8dp"
                            app:cardBackgroundColor="#333333">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="vertical"
                                    android:gravity="center">

                                        <TextView
                                            android:id="@+id/tvAllTime"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="TIME LEFT :"
                                            android:textColor="#00E5C5"
                                            android:textStyle="bold"
                                            android:textSize="15sp" />

                                        <TextView
                                            android:id="@+id/tv_timer"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text=" 10 "
                                            android:textColor="#00E5C5"
                                            android:textStyle="bold"
                                            android:textSize="18sp" />

                                </LinearLayout>
                        </androidx.cardview.widget.CardView>

                </FrameLayout>
        </LinearLayout>

        <!-- Buttons -->
        <LinearLayout
            android:id="@+id/buttons_game_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_below="@id/score_cards"
            android:layout_marginTop="16dp"
            android:paddingHorizontal="8dp"
            android:gravity="center">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_1_player"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/rounded_button_medium"
                    android:layout_weight="1"
                    android:text="Start"
                    android:textSize="17sp"
                    android:textColor="@color/white"
                    android:textStyle="normal"
                    android:onClick="gameSingleMode"
                    android:layout_margin="7dp" />

                <!-- Uncomment for 2 players mode if needed -->
                <!--
                <Button
                    android:id="@+id/btn_2_player"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="2 Players mode"
                    android:textSize="17sp"
                    android:textColor="@color/color_Btn_Idle"
                    android:textStyle="normal"
                    android:onClick="gameTwoPlayersMode"
                    android:layout_margin="7dp" />
                -->
        </LinearLayout>

        <!-- Game Info (Player, Timer, Level) -->
        <LinearLayout
            android:id="@+id/tv_game_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/buttons_game_mode"
            android:paddingHorizontal="7dp"
            android:paddingVertical="8dp"
            android:gravity="center"
            android:orientation="horizontal">





               <!-- <TextView
                    android:id="@+id/tv_level"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="LEVEL: 0"
                    android:textColor="@color/color_white"
                    android:textStyle="bold"
                    android:textAlignment="center"
                    android:textSize="20sp"
                    android:padding="5dp" />-->
        </LinearLayout>

        <!-- Game Panel -->
        <RelativeLayout
            android:id="@+id/cards_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/tv_game_info"
            android:gravity="center">

                <com.example.fungames.soundMemory.smg_CustomView
                    android:layout_width="350dp"
                    android:layout_height="350dp"
                    android:id="@+id/simon_panel" />
        </RelativeLayout>

</RelativeLayout>
